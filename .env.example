# -----------------------------------------------------------------------------
# Gadaa Istar E-Commerce — Environment Configuration (example)
#
# Copy to `.env` (in the same folder as docker-compose.yml or wherever needed),
# then fill in real values. NEVER commit .env to version control.
# In staging/production, secrets come from HashiCorp Vault, not from files.
# -----------------------------------------------------------------------------

# --- PostgreSQL (local dev) ---
POSTGRES_PASSWORD=rootpw
POSTGRES_DB=GCOMERCE
POSTGRES_USER=gadaa
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend (Quarkus) ---
QUARKUS_HTTP_PORT=8080
QUARKUS_DATASOURCE_URL=jdbc:postgresql://postgres:5432/GCOMERCE
QUARKUS_DATASOURCE_USERNAME=${POSTGRES_USER}
QUARKUS_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
QUARKUS_LOG_LEVEL=INFO

# --- JWT (dev only — DO NOT reuse in production) ---
# NOTE: secrets MUST be >= 32 characters (JwtIssuer validates this on startup).
# In production these come from HashiCorp Vault, never files.
GADAA_JWT_STOREFRONT_ISSUER=https://api.dev.gadaaistar.com/storefront
GADAA_JWT_STOREFRONT_SECRET=dev-storefront-secret-change-me-32-chars-min-length!
GADAA_JWT_ADMIN_ISSUER=https://api.dev.gadaaistar.com/admin
GADAA_JWT_ADMIN_SECRET=dev-admin-secret-change-me-32-chars-min-length-abcdef!
GADAA_JWT_ACCESS_TTL_MINUTES=15
GADAA_JWT_REFRESH_TTL_DAYS=30

# --- Frontend base URLs (used by backend to build emailed links) ---
STOREFRONT_BASE_URL=https://gedaaistar.et
ADMIN_BASE_URL=https://admin.gedaaistar.et

# --- Rate limiting (in-memory sliding window, Phase 2.4) ---
# Set to false to disable the limiter entirely (load tests, staging exercises).
# Multi-instance / Redis-backed variant lands in Phase 3.
GADAA_RATELIMIT_ENABLED=true
GADAA_RATELIMIT_MAX_QUEUE_SIZE=1024

# --- Auth flows (verification & reset link TTLs, minutes) ---
GADAA_EMAIL_VERIFICATION_TTL_MINUTES=60
GADAA_PASSWORD_RESET_TTL_MINUTES=30

# --- Admin API (Quarkus, second runtime module) ---
QUARKUS_ADMIN_HTTP_PORT=8081

# --- Admin MFA (TOTP / RFC 6238) ---
# Issuer label shown inside authenticator apps (Google Authenticator, Authy, ...)
GADAA_ADMIN_MFA_ISSUER=Gadaa Istar Admin
# Short-lived challenge JWT — how long the /verify-mfa step remains valid
GADAA_ADMIN_MFA_CHALLENGE_TTL_SECONDS=300
# ± this many 30-second windows accepted during verification (0 = strict)
GADAA_ADMIN_MFA_WINDOW_TOLERANCE=1

# --- Bootstrap super-admin (V3 migration seeds this account) ---
# Email:    admin@gadaaistar.com
# Password: ChangeMe-Admin-2026!   (BCrypt cost-12 hash lives in V3__admin_auth_and_mfa.sql)
# MFA:      not enrolled — the first sign-in triggers the enrollment flow.
# ROTATE IMMEDIATELY in staging and production.

# --- CyberSource Secure Acceptance Hosted Checkout (TEST credentials) ---
CYBERSOURCE_ENV=test
CYBERSOURCE_ENDPOINT=https://testsecureacceptance.cybersource.com/pay
CYBERSOURCE_ACCESS_KEY=your_test_access_key_here
CYBERSOURCE_PROFILE_ID=your_test_profile_id_here
CYBERSOURCE_SECRET_KEY=your_test_secret_key_here
CYBERSOURCE_MERCHANT_ID=your_test_merchant_id_here
CYBERSOURCE_REST_HOST=apitest.cybersource.com

# --- MPGS (Mastercard Payment Gateway Services) Hosted Checkout ---
# Set MPGS_ENABLED=true to offer MPGS as a payment option at checkout.
# Gateway URL varies by your MPGS provider/region.
MPGS_ENABLED=false
MPGS_GATEWAY_URL=https://test-gateway.mastercard.com
MPGS_MERCHANT_ID=your_mpgs_merchant_id_here
MPGS_API_PASSWORD=your_mpgs_api_password_here
MPGS_API_VERSION=62
MPGS_CHECKOUT_VERSION=62
MPGS_NOTIFICATION_SECRET=your_mpgs_webhook_notification_secret_here

# --- YagoutPay Aggregator Hosted (Non-Seamless) Checkout ---
# Set YAGOUTPAY_ENABLED=true to offer YagoutPay at checkout.
# Merchant credentials are issued by YagoutPay at onboarding; the encryption
# key is base64 and must decode to 16/24/32 bytes (AES-128/192/256).
# CALLBACK_BASE_URL must be a domain registered with YagoutPay — requests
# from unregistered domains fail with "Invalid Referral URL".
YAGOUTPAY_ENABLED=false
YAGOUTPAY_MERCHANT_ID=your_yagoutpay_merchant_id_here
YAGOUTPAY_ENCRYPTION_KEY=your_yagoutpay_base64_encryption_key_here
YAGOUTPAY_AGGREGATOR_ID=yagout
YAGOUTPAY_GATEWAY_URL=https://uatcheckout.yagoutpay.com/ms-transaction-core-1-0/paymentRedirection/checksumGatewayPage
YAGOUTPAY_CALLBACK_BASE_URL=https://api.gedaaistar.et
YAGOUTPAY_COUNTRY=ETH
# Optional comma-separated currency allowlist (empty = all currencies).
YAGOUTPAY_SUPPORTED_CURRENCIES=

# --- Object storage (MinIO local; S3 in cloud) ---
# ENDPOINT is the backend-to-storage URL (inside docker network).
# PUBLIC_BASE_URL is the browser-facing hostname — used to build <img src="...">.
# In dev these differ (backend talks to "minio:9000" internally but the browser
# needs "localhost:9000"). In prod, PUBLIC_BASE_URL is your CDN hostname.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_pw
S3_BUCKET_MEDIA=gadaa-media
S3_BUCKET_INVOICES=gadaa-invoices
S3_USE_PATH_STYLE=true
# Max product-media upload size in bytes (default 20 MB).
S3_MAX_UPLOAD_BYTES=20971520

# --- SMTP (MailHog for local dev) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@gadaaistar.com
SMTP_FROM_NAME=Gadaa Istar

# --- Cloudflare Turnstile / reCAPTCHA (contact form) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Company / tax profile (used to seed initial data) ---
GADAA_COMPANY_LEGAL_NAME=Gadaa Istar Business Group S.C.
GADAA_COMPANY_TIN=
GADAA_COMPANY_VAT_NUMBER=
GADAA_COMPANY_ADDRESS=Addis Ababa, Ethiopia
GADAA_COMPANY_PHONE=
GADAA_COMPANY_EMAIL=info@gadaaistar.com
GADAA_INVOICE_PREFIX=GI
GADAA_CREDIT_NOTE_PREFIX=CN
GADAA_FISCAL_YEAR_START_MONTH=7  # Ethiopian fiscal year starts in July (Hamle)

# --- Frontend base URLs (Angular apps read at build time via environment.ts) ---
STOREFRONT_API_BASE=http://localhost:8080/api/storefront/v1
ADMIN_API_BASE=http://localhost:8080/api/admin/v1
STOREFRONT_BASE_URL=https://gedaaistar.et
ADMIN_BASE_URL=https://admin.gedaaistar.et
